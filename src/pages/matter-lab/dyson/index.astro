---
import '../../../styles/tailwind.css';
---
<!doctype html>
<html lang="es" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f2efe7" />
    <title>Prueba Dyson · Materia digital</title>
    <meta name="description" content="Prueba aislada de ocho anillos continuos animados en Blender y reproducidos con WebGL." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="m-0 bg-paper font-sans text-ink antialiased selection:bg-electric selection:text-paper [&_[hidden]]:hidden">
    <header class="mx-auto flex max-w-[1440px] items-center justify-between gap-4 border-b border-rule px-5 py-5 md:px-10">
      <a class="font-mono text-xs uppercase tracking-widest underline-offset-4 hover:text-electric focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-electric" href="/matter-lab/">← Matter lab</a>
      <span class="font-mono text-[10px] uppercase tracking-widest text-muted md:text-xs">Prueba / Dyson 001</span>
    </header>

    <main>
      <section class="mx-auto max-w-[1440px] px-5 py-14 md:px-10 md:py-24" aria-labelledby="dyson-title">
        <div class="grid gap-10 border-b border-rule pb-12 md:grid-cols-12 md:gap-6 md:pb-16">
          <div class="md:col-span-8">
            <p class="font-mono text-xs uppercase tracking-widest text-electric">Blender 5.2 · geometría editable</p>
            <h1 id="dyson-title" class="mt-5 max-w-[11ch] text-[clamp(3.5rem,8vw,7.5rem)] font-bold leading-[.9] tracking-[-.045em] text-balance">Ocho anillos, ocho movimientos.</h1>
          </div>
          <div class="self-end md:col-span-4">
            <p class="max-w-[42ch] text-lg leading-snug md:text-xl">Dos capas de anillos cerrados giran con trayectorias propias alrededor de un núcleo pequeño. El scroll recorre exactamente la animación creada en Blender.</p>
            <dl class="mt-8 grid grid-cols-2 gap-x-5 gap-y-4 border-t border-rule pt-4 font-mono text-[10px] uppercase tracking-wider text-muted md:text-xs">
              <div><dt>Anillos</dt><dd class="mt-1 text-ink">8 continuos</dd></div>
              <div><dt>Muestras</dt><dd class="mt-1 text-ink">61 poses</dd></div>
              <div><dt>Escritorio</dt><dd class="mt-1 text-ink">44 000 puntos</dd></div>
              <div><dt>Móvil</dt><dd class="mt-1 text-ink">20 000 puntos</dd></div>
            </dl>
            <a href="#dyson-motion" class="mt-8 inline-flex min-h-12 items-center gap-8 bg-electric px-6 py-3 text-sm font-semibold text-paper hover:bg-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-electric">Probar movimiento <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-[1440px] px-5 pb-20 md:px-10 md:pb-28" aria-labelledby="reference-title">
        <div class="grid items-end gap-6 border-b border-rule pb-5 md:grid-cols-12">
          <h2 id="reference-title" class="text-[clamp(2.5rem,5vw,5rem)] font-semibold leading-none tracking-[-.04em] md:col-span-8">Referencia aprobada</h2>
          <p class="font-mono text-[10px] uppercase tracking-wider text-muted md:col-span-4 md:text-right md:text-xs">La animación conserva esta silueta y su lenguaje de puntos</p>
        </div>
        <figure class="mt-8 border border-rule bg-white/25 p-3 md:p-6">
          <img src="/matter-lab/dyson/dyson-reference.png" width="1536" height="1024" alt="Estructura abstracta de núcleo y anillos continuos representada con puntos negros" class="mx-auto block h-auto max-h-[74vh] w-full object-contain" />
        </figure>
      </section>

      <section id="dyson-motion" class="relative h-[620vh] scroll-mt-0 border-y border-rule" data-dyson-story aria-label="Animación Dyson vinculada al scroll">
        <div class="sticky top-0 flex h-screen flex-col justify-center gap-4 px-5 py-5 md:gap-6 md:px-10 md:py-8">
          <div class="mx-auto flex w-full max-w-[1440px] items-center justify-between gap-4 font-mono text-[10px] uppercase tracking-widest text-muted md:text-xs">
            <span>Blender / movimiento independiente</span>
            <span data-dyson-progress>Movimiento 000%</span>
          </div>
          <div class="mx-auto w-full max-w-[1440px] border-y border-rule py-3 md:py-6">
            <div class="group relative mx-auto aspect-[4/5] w-full overflow-hidden bg-paper md:aspect-[16/7]" data-dyson-stage>
              <img src="/matter-lab/dyson/dyson-pose.png" width="1600" height="900" alt="Vista estática de la estructura Dyson exportada desde Blender" class="absolute inset-0 h-full w-full object-contain transition-opacity duration-200 group-data-[dyson-ready=true]:opacity-0" />
              <canvas class="absolute inset-0 h-full w-full" data-dyson-canvas aria-hidden="true" hidden></canvas>
            </div>
          </div>
          <div class="mx-auto w-full max-w-[1440px]">
            <label for="dyson-scrubber" class="sr-only">Recorrer manualmente el movimiento de los anillos</label>
            <input id="dyson-scrubber" data-dyson-scrubber type="range" min="0" max="1000" value="0" class="h-8 w-full cursor-ew-resize accent-electric focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-electric" />
            <div class="flex flex-wrap items-center justify-between gap-3 font-mono text-[10px] uppercase tracking-widest text-muted md:text-xs">
              <p role="status" aria-live="polite" data-dyson-status>Preparando los puntos exportados desde Blender…</p>
              <button type="button" hidden data-dyson-enable-motion class="cursor-pointer border border-electric px-3 py-2 text-electric hover:bg-electric hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-electric">Activar movimiento en esta prueba</button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-4 px-5 py-7 font-mono text-xs md:px-10">
      <span>Prueba aislada / aún no integrada al Hero</span>
      <a href="/" class="underline underline-offset-4 hover:text-electric focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-electric">Volver al portafolio ↗</a>
    </footer>
    <script>
      import {initializeDysonLab} from '../../../scripts/dyson-lab';
      initializeDysonLab();
    </script>
  </body>
</html>
