---
import {type Locale} from '../data/portfolio';
interface Props {variant: 'monitoring' | 'extraction'; locale: Locale; alt: string}
const {variant, locale, alt} = Astro.props;
const dark = variant === 'extraction';
const ink = dark ? '#f2efe7' : '#11110f';
const blue = dark ? '#91a4ff' : '#3157ff';
const muted = dark ? '#b9b6af' : '#66635c';
const es = locale === 'es';
---
<svg class="flow-diagram h-auto w-full" viewBox={variant === 'monitoring' ? '0 65 720 230' : '0 0 720 340'} xmlns="http://www.w3.org/2000/svg" role="img" aria-label={alt} fill="none">
  <title>{alt}</title>
  {variant === 'monitoring' ? <>
    <g stroke={ink} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="60" y="96" width="68" height="100" rx="3" /><path d="M84 96V73h12v23m-20 72h36m-30 13h24" />
      <path d="M139 112q16 16 0 32m10-42q25 25 0 52" />
      <path d="M178 153h102m-10-9 10 9-10 9" />
      <rect x="304" y="102" width="105" height="28" rx="2" /><rect x="304" y="144" width="105" height="28" rx="2" /><rect x="304" y="186" width="105" height="28" rx="2" />
      <circle cx="318" cy="116" r="3" /><circle cx="318" cy="158" r="3" /><circle cx="318" cy="200" r="3" /><path d="M334 116h53m-53 42h53m-53 42h53" />
      <path d="M432 153h102m-10-9 10 9-10 9" />
      <rect x="558" y="94" width="116" height="103" rx="2" /><path d="M595 211h43m-22-14v14" />
    </g>
    <path d="M578 174v-26m18 26v-43m18 43v-33m18 33v-60m18 60v-48" stroke={blue} stroke-width="3" />
    <g fill={ink} font-family="monospace" font-size="17" text-anchor="middle"><text x="96" y="250">{es ? 'Sensores' : 'Sensors'}</text><text x="356" y="250">{es ? 'Servicios' : 'Services'}</text><text x="616" y="250">{es ? 'Visualización' : 'Visualization'}</text></g>
    <g fill={muted} font-family="monospace" font-size="13" text-anchor="middle"><text x="96" y="278">IoT</text><text x="356" y="278">Python / FastAPI</text><text x="616" y="278">{es ? 'Web + móvil' : 'Web + mobile'}</text></g>
  </> : <>
    <g stroke={ink} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M62 83h70l24 24v112H62zm70 0v24h24" /><path d="M82 128h52m-52 16h45m-45 16h52m-52 16h30" />
      <path d="M180 153h102m-10-9 10 9-10 9" />
      <rect x="308" y="105" width="112" height="96" rx="2" /><path d="M299 127h9m-9 24h9m-9 24h9m112-48h9m-9 24h9m-9 24h9M333 96v9m24-9v9m24-9v9m-48 96v9m24-9v9m24-9v9" />
      <path d="M446 153h91m-10-9 10 9-10 9" /><path d="M580 113h-14v83h14m68-83h14v83h-14" />
    </g>
    <g fill={blue} font-family="monospace" font-size="28" text-anchor="middle"><text x="364" y="164">LLM</text></g>
    <g stroke={blue} stroke-width="3"><path d="M589 125h39m-39 21h49m-49 21h27m-27 21h43" /></g>
    <g fill={ink} font-family="monospace" font-size="17" text-anchor="middle"><text x="110" y="250">{es ? 'Documento' : 'Document'}</text><text x="364" y="250">{es ? 'Extracción' : 'Extraction'}</text><text x="614" y="250">{es ? 'Datos' : 'Data'}</text></g>
    <g fill={muted} font-family="monospace" font-size="13" text-anchor="middle"><text x="110" y="278">{es ? 'Escaneado' : 'Scanned'}</text><text x="364" y="278">{es ? 'IA aplicada' : 'Applied AI'}</text><text x="614" y="278">{es ? 'Estructurados' : 'Structured'}</text></g>
  </>}
</svg>
